/docs/
/lib/
/bin/
/.shards/
*.dwarf

# Libraries don't need dependency lock
# Dependencies will be locked in applications that use them
/shard.lock
.croupier
/coverage/
/spec/testcases/**/input*
/spec/testcases/**/output*
/spec/testcases/**/store
# The "empty" scenario is a scratch dir for tests that generate arbitrary
# output filenames; ignore everything in it except the tracked .keep.
/spec/testcases/empty/*
!/spec/testcases/empty/.keep
/.claude/
/.zcode/
# The run_all_fresh scenario is a scratch dir like "empty": the spec
# creates and counts its inputs/outputs/marker at runtime.
/spec/testcases/run_all_fresh/*
!/spec/testcases/run_all_fresh/tasks.yml
